# Copy to .env and fill in. `docker compose` reads this file automatically.

# --- OpenRouter ---
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Model slug. Default is Google Gemma (free tier on OpenRouter).
# Swap freely, e.g. google/gemma-4-26b-a4b-it:free
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Inference params
MAX_TOKENS=1024
TEMPERATURE=0.7
