# Copy to .env and fill in. `docker compose` reads this file automatically.

# --- AWS / Bedrock ---
AWS_REGION=us-east-1
# Native Bedrock model id. Default is Google Gemma 3 4B IT.
# Swap freely, e.g. google.gemma-3-12b-it, anthropic.claude-3-5-haiku-20241022-v1:0
BEDROCK_MODEL_ID=google.gemma-3-4b-it

# Inference params
MAX_TOKENS=1024
TEMPERATURE=0.7

# --- AWS credentials ---
# Provide a principal allowed to call bedrock:InvokeModelWithResponseStream
# (and bedrock:Converse) for the model above, in the region above.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only needed for temporary/STS credentials:
AWS_SESSION_TOKEN=
